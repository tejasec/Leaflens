<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/appBackgroundColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="40dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:tint="?attr/textPrimaryColor"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvPestDetailName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pest Management Profile"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?attr/textPrimaryColor"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvPestAffectedCrops"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Affected Crops: Tomato, Maize, Wheat"
            android:textSize="14sp"
            android:textColor="#10B981"
            android:layout_marginBottom="20dp" />

        <!-- Symptoms Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="?attr/cardBackgroundColor"
            app:strokeColor="?attr/cardStrokeColor"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍 Crop Symptoms &amp; Damage"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FBBF24"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvPestSymptoms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Leaves yellowing, stunted growth, honey-dew secretion."
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="?attr/textSecondaryColor" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Management Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="?attr/cardBackgroundColor"
            app:strokeColor="#10B981"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️ Integrated Pest Management (IPM)"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#10B981"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvPestManagement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Biological: Encourage ladybug predators\n• Organic: Spray Neem kernel oil (5ml/L)\n• Cultural: Install yellow sticky traps"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="?attr/textPrimaryColor" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
