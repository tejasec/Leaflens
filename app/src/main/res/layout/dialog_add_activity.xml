<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/cardBackgroundColor"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:strokeColor="?attr/cardStrokeColor"
    app:strokeWidth="1dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvDialogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="➕ Add Crop Activity Reminder"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crop Name"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/textSecondaryColor"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etCrop"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="14dp"
                android:hint="Crop Name (e.g. Tomato, Cotton)"
                android:textColor="?attr/textPrimaryColor"
                android:textColorHint="?attr/textSecondaryColor"
                android:textSize="14sp"
                android:inputType="textCapWords"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activity Description"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/textSecondaryColor"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="14dp"
                android:hint="Activity Description (e.g. Top Dressing)"
                android:textColor="?attr/textPrimaryColor"
                android:textColorHint="?attr/textSecondaryColor"
                android:textSize="14sp"
                android:inputType="textCapSentences"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activity Type"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/textSecondaryColor"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerType"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_spinner_selector"
                android:popupBackground="?attr/cardBackgroundColor"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reminder Timing"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/textSecondaryColor"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerDelay"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_spinner_selector"
                android:popupBackground="?attr/cardBackgroundColor"
                android:layout_marginBottom="16dp" />

            <CheckBox
                android:id="@+id/cbIsDaily"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔁 Repeat Daily (Daily Routine)"
                android:textColor="?attr/textPrimaryColor"
                android:buttonTint="#10B981"
                android:textSize="14sp"
                android:layout_marginBottom="20dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <Button
                    android:id="@+id/btnCancel"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Cancel"
                    android:textColor="?attr/textPrimaryColor"
                    app:strokeColor="?attr/cardStrokeColor"
                    app:cornerRadius="10dp"
                    android:layout_marginEnd="12dp" />

                <Button
                    android:id="@+id/btnSchedule"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Schedule &amp; Save"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#10B981"
                    app:cornerRadius="10dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
