<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121814"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Offline 10-Sample Benchmark Gallery"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap any sample card to benchmark pipeline &amp; measure side-by-side telemetry latency."
        android:textSize="13sp"
        android:textColor="#9CA3AF"
        android:layout_marginBottom="16dp" />

    <!-- Telemetry Display Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTelemetry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#1C241E"
        app:strokeColor="#10B981"
        app:strokeWidth="1dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Execution Telemetry Benchmark"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#10B981"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Pre-flight latency -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvQualityLatency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- ms"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#60A5FA" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quality Check"
                        android:textSize="11sp"
                        android:textColor="#9CA3AF" />
                </LinearLayout>

                <!-- TFLite Inference latency -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvInferenceLatency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- ms"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#34D399" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TFLite Inference"
                        android:textSize="11sp"
                        android:textColor="#9CA3AF" />
                </LinearLayout>

                <!-- Grad-CAM latency -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvGradCamLatency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- ms"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FBBF24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Grad-CAM Map"
                        android:textSize="11sp"
                        android:textColor="#9CA3AF" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvTelemetryDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select a sample leaf below to execute benchmark pipeline."
                android:textSize="12sp"
                android:textColor="#E5E7EB"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Benchmark Sample List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBenchmarkSamples"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

</LinearLayout>
