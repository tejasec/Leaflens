<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/rounded_button"
    android:backgroundTint="#1C241E"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/ivDiseaseThumb"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/rounded_button"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_1" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDiseaseTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Early Blight"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDiseaseScientific"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Alternaria solani"
            android:textColor="#9CA3AF"
            android:textSize="12sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/tvDiseaseShortDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Dark, concentric spots on leaves."
            android:textColor="#D1D5DB"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="❯"
        android:textColor="#6B7280"
        android:textSize="16sp" />

</LinearLayout>