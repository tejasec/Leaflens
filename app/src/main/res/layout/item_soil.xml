<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#1C241E"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeColor="#2E3B31"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvSoilType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Soil Type"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Properties:"
            android:textStyle="bold"
            android:textColor="#10B981" />

        <TextView
            android:id="@+id/tvProperties"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Good water retention, rich in nutrients."
            android:textColor="#9CA3AF" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Suitable Crops:"
            android:textStyle="bold"
            android:textColor="#10B981" />

        <TextView
            android:id="@+id/tvSuitableCrops"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Rice, Wheat, Sugarcane"
            android:textStyle="italic"
            android:textColor="#9CA3AF" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
