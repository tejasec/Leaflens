<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="?attr/cardBackgroundColor"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeColor="?attr/cardStrokeColor"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvActivityType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 CROP CALENDAR"
                android:background="?attr/cardStrokeColor"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="#10B981"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDailyBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="🔁 DAILY"
                android:background="@drawable/rounded_button"
                android:backgroundTint="#263B82F6"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="#3B82F6"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnEditActivity"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_edit"
                app:tint="#3B82F6"
                android:contentDescription="Edit"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/btnDeleteActivity"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#EF4444"
                android:contentDescription="Delete"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCropName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crop Activity"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/textPrimaryColor" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sowing: "
                android:textStyle="bold"
                android:textColor="#10B981"/>

            <TextView
                android:id="@+id/tvSowing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="June - July"
                android:textColor="?attr/textSecondaryColor"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Harvest: "
                android:textStyle="bold"
                android:textColor="#10B981"/>

            <TextView
                android:id="@+id/tvHarvest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="October - November"
                android:textColor="?attr/textSecondaryColor"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Description goes here."
            android:textColor="?attr/textSecondaryColor" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
