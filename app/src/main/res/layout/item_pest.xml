<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#1C241E"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeColor="#2E3B31"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvPestName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pest Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvAffectedCrops"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Affected Crops: Rice, Wheat"
            android:textStyle="italic"
            android:textColor="#10B981" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Solution / Integrated Control:"
            android:textStyle="bold"
            android:textColor="#E5E7EB" />

        <TextView
            android:id="@+id/tvSolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Apply neem oil spray every 2 weeks."
            android:textColor="#9CA3AF" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
