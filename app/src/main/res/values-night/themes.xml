<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme in Night mode. -->
    <style name="Base.Theme.SmartAgriculture" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorSecondaryVariant</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        
        <!-- Backgrounds & Surfaces -->
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorSurfaceVariant">@color/surface_variant_dark</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_dark</item>
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
        <item name="android:editTextColor">@color/text_primary_dark</item>
        <item name="android:textColorHint">@color/text_hint_dark</item>

        <!-- Semantic Theme Color Overrides (Default Dark/Green Mode) -->
        <item name="appBackgroundColor">@color/bg_dark</item>
        <item name="cardBackgroundColor">@color/surface_dark</item>
        <item name="cardStrokeColor">@color/card_stroke_dark</item>
        <item name="textPrimaryColor">@color/text_primary_dark</item>
        <item name="textSecondaryColor">@color/text_secondary_dark</item>
        <item name="dividerLineColor">@color/card_stroke_dark</item>
        <item name="dangerCardBgColor">@color/surface_dark</item>

        <!-- Disable/Hide System Status Bar -->
        <item name="android:windowFullscreen">true</item>

        <!-- Typography -->
        <item name="fontFamily">sans-serif</item>
    </style>
</resources>